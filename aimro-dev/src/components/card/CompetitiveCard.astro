---
interface Props {
    number: string;
    title: string;
    description: string;
}

const { number, title, description } = Astro.props;
---

<div
    class="group
    relative
    overflow-hidden
    rounded-md
    border
    border-gray-200
    bg-gradient-to-br
    from-white
    via-white
    to-primary/5
    p-8
    transition-all
    duration-300
    hover:-translate-y-1
    hover:border-primary/30
    hover:shadow-sm"
>
    <div
        class="absolute
        -right-12
        -top-12
        h-36
        w-36
        rounded-full
        bg-primary/10
        blur-3xl"
    >
    </div>

    <div class="relative">
        <span
            class="inline-flex
            h-12
            w-12
            items-center
            justify-center
            rounded-full
            bg-primary
            text-lg
            font-bold
            text-white"
        >
            {number}
        </span>

        <h3
            class="mt-4
            text-xl
            font-bold
            leading-tight"
        >
            {title}
        </h3>

        <p class="mt-4
            leading-6
            text-gray-500">
            {description}
        </p>
    </div>
</div>
