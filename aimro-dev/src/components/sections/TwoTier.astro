---
const executor = [
    "Deep learning from demonstrations using real data",
    "Reasoning, abstracting and optimizing actions",
    "Intelligent runtime system for real-time execution and adaptive operations",
];

const tower = [
    "Coordinates robots, AGVs,AMRs, and plant-level workflows",
    "Executes the productionplan.Interacts with existing MES",
    "Optimizing in real time. Natural language control.",
];
---

<section class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <!-- Heading -->
        <div class="mx-auto max-w-3xl text-center">
            <p
                class="text-primary text-lg font-semibold uppercase tracking-wider"
            >
                AIM AIOS
            </p>

            <h2 class="mt-4 text-3xl sm:text-4xl lg:text-5xl font-bold">
                Two-Tier Artificial Intelligence Operating System
            </h2>

            <p class="mt-8 text-base sm:text-lg leading-8 text-gray-500">
                AIM AIOS combines demonstration learning, real production data,
                and intelligent orchestration across workcells and factory
                operations.
            </p>
        </div>

        <!-- Desktop Layout -->
        <div
            class="hidden lg:grid mt-16 grid-cols-[1fr_auto_1fr] items-start gap-8"
        >
            <!-- Executor -->
            <div class="p-8">
                <h3 class="text-3xl font-bold">AIM Executor</h3>

                <p class="mt-2 leading-8 text-gray-500">
                    The on-cell
                    <span class="text-primary font-semibold"
                        >{" "}"Brain"{" "}</span
                    >
                    with execution layer for workcell operations.
                </p>

                <ul class="mt-8 space-y-8">
                    {
                        executor.map((item) => (
                            <li class="flex items-start gap-4">
                                <div class="mt-2 h-2 w-2 rounded-full bg-primary shrink-0" />
                                <p class="leading-7 text-gray-500">{item}</p>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- AIOS -->
            <div class="flex h-full items-center justify-center">
                <div class="flex flex-col items-center">
                    <div class="h-16 w-px bg-primary/40"></div>

                    <div
                        class="rounded-full border border-primary bg-secondary px-8 py-4
                    text-lg font-semibold tracking-widest text-primary"
                    >
                        AIOS
                    </div>

                    <div class="h-16 w-px bg-primary/40"></div>
                </div>
            </div>

            <!-- Tower -->
            <div class="p-8">
                <h3 class="text-3xl font-bold">AIM Tower</h3>

                <p class="mt-2 leading-8 text-gray-500">
                    The line-level
                    <span class="text-primary font-semibold">
                        {" "}"Business Brain"{" "}
                    </span>
                    orchestrating overall production processes.
                </p>

                <ul class="mt-8 space-y-8">
                    {
                        tower.map((item) => (
                            <li class="flex items-start gap-4">
                                <div class="mt-2 h-2 w-2 rounded-full bg-primary shrink-0" />
                                <p class="leading-7 text-gray-500">{item}</p>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>

        <!-- Mobile Layout -->
        <div class="mt-12 flex flex-col gap-8 lg:hidden">
            <div class="p-4">
                <h3 class="text-2xl font-bold">AIM Executor</h3>

                <p class="mt-2 text-gray-500 leading-7">
                    The on-cell
                    <span class="text-primary font-semibold">{" "}"Brain"{" "}</span>
                    with execution layer for workcell operations.
                </p>

                <ul class="mt-4 space-y-4">
                    {
                        executor.map((item) => (
                            <li class="flex items-start gap-2">
                                <div class="mt-2 h-2 w-2 rounded-full bg-primary shrink-0" />
                                <p class="leading-7 text-gray-500">{item}</p>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <div class="p-8">
                <h3 class="text-2xl font-bold">AIM Tower</h3>

                <p class="mt-2 text-gray-500 leading-7">
                    The line-level
                    <span class="text-primary font-semibold">
                        {" "}"Business Brain"{" "}
                    </span>
                    orchestrating overall production processes.
                </p>

                <ul class="mt-4 space-y-4">
                    {
                        tower.map((item) => (
                            <li class="flex items-start gap-2">
                                <div class="mt-2 h-2 w-2 rounded-full bg-primary shrink-0" />
                                <p class="leading-7 text-gray-500">{item}</p>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </div>
</section>
