---
const executor = [
    "Deep learning from demonstrations using real data",
    "Reasoning, abstracting and optimizing actions",
    "Intelligent runtime system for real-time execution and adaptive operations",
];

const tower = [
    "Coordinates robots, AGVs,AMRs, and plant-level workflows",
    "Executes the productionplan.Interacts with existing MES",
    "Optimizing in real time. Natural language control.",
];
---

<section class="py-16">
    <div class="mx-auto max-w-6xl px-4 md:px-8">
        <!-- Heading -->
        <div class="mx-auto max-w-3xl text-center space-y-4">
            <p
                class="text-primary text-xl font-semibold uppercase tracking-tight"
            >
                AIM AIOS
            </p>

            <h2 class="text-5xl font-bold">
                Two-Tier Artificial Intelligence Operating System
            </h2>

            <p class="text-lg leading-8 text-gray-500">
                AIM AIOS combines demonstration learning, real production data,
                and intelligent orchestration across workcells and factory
                operations.
            </p>
        </div>

        <div class="mt-16">

            <div class="grid gap-8 lg:gap-24 lg:grid-cols-[1fr_auto_1fr]">
                <div class="flex flex-col items-center text-center lg:items-end lg:text-right">
                    <h3 class="text-3xl font-bold">AIM Executor</h3>
                    <p class="mt-2 max-w-sm leading-8 text-gray-500 lg:text-right">
                        The on-cell
                        <span class="text-primary">{" "}"Brain"{" "}</span>
                        with execution layer for workcell operations.
                    </p>
                </div>

                <div></div>

                <div class="text-center lg:text-left">
                    <h3 class="text-3xl font-bold">AIM Tower</h3>
                    <p class="mt-2 max-w-sm leading-8 text-gray-500">
                        The line-level
                        <span class="text-primary">{" "}"Business Brain"{" "}</span>
                        orchestrating overall production processes.
                    </p>
                </div>
            </div>

            <div class="mt-12 grid gap-12 lg:grid-cols-[1fr_auto_1fr] lg:items-center">
  
                <div class="flex flex-col items-end">
                    <div class="space-y-8">
                        {
                            executor.map((item) => (
                                <div class="flex items-center justify-center lg:justify-end">
                                    <p class="max-w-xs text-center lg:text-right leading-7 text-gray-500">
                                        {item}
                                    </p>

                                    <div class="ml-4 h-2 w-2 rounded-full bg-primary" />
                                    <div class="h-px w-16 bg-primary" />
                                </div>
                            ))
                        }
                    </div>
                </div>

                <div class="flex items-center justify-center">
                    <div class="relative flex items-center justify-center">
                        
                        <div class="absolute hidden h-64 w-px bg-white/10 lg:block"></div>

                        <div
                            class="relative rounded-full border border-primary
                           bg-secondary px-8 py-4
                           font-semibold tracking-wider text-primary"
                        >
                            AIOS
                        </div>
                    </div>
                </div>

                <div class="flex flex-col">
                    <div class="space-y-8">
                        {
                            tower.map((item) => (
                                <div class="flex items-center justify-center lg:justify-start">
                                    <div class="h-px w-16 bg-primary" />
                                    <div class="mr-4 h-2 w-2 rounded-full bg-primary" />

                                    <p class="max-w-xs text-center lg:text-left 
                                    leading-7 text-gray-500">
                                        {item}
                                    </p>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
