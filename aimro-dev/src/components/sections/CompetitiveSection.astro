---
import CompetitiveCard from "@/components/card/CompetitiveCard.astro";

const cards = [
    {
        number: "01",
        title: "Top-Tier AI Talent",
        description:
            "Proprietary foundation world model backed by talents from Harvard, MIT, and Tsinghua.",
    },
    {
        number: "02",
        title: "U.S. Production at Lowest Cost",
        description:
            "Domestic manufacturing for quality and security, at the lowest cost.",
    },
    {
        number: "03",
        title: "Full IP Ownership with Rapid Innovation",
        description:
            "100% IP ownership; unrestricted development and manufacturing.",
    },
    {
        number: "04",
        title: "Customer-Ready & Data-Rich",
        description:
            "Customers in pipeline; direct access to real training data.",
    },
    {
        number: "05",
        title: "Experienced Technical Team",
        description:
            "Experienced development and implementation team in AI, IE, robotics and computer vision with global locations.",
    },
    {
        number: "06",
        title: "Tele-Human-In-The-Loop Solutions",
        description:
            "Enable unrestricted human involvement in RPA processes remotely.",
    },
];
---

<section class="py-16">
    <div class="mx-auto max-w-6xl px-4 md:px-8">
        <!-- Heading -->

        <div class="max-w-3xl space-y-4">
            <p
                class="text-primary text-xl font-semibold uppercase tracking-tight"
            >
                Competitive Advantages
            </p>

            <h2 class="text-4xl font-bold leading-tight md:text-5xl">
                AIM Robots has an experienced team and resources to lead the
                reshoring revolution.
            </h2>
        </div>

        <!-- Cards -->

        <div
            class="mt-16
            grid
            gap-6
            md:grid-cols-2
            lg:grid-cols-3"
        >
            {cards.map((card) => <CompetitiveCard {...card} />)}
        </div>
    </div>
</section>
