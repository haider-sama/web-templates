---
const capabilities = [
    "AIOS (Executor + Tower) embeds industrial domain knowledge and reusable automation skills.",
    "AIOS enables rapid factory-level automation implementation within weeks.",
    "Every implementation enriches AIOS through captured workflows and execution knowledge.",
    "AIOS expands into new industrial sectors as domain knowledge compounds over time.",
];

const cards = [
    {
        title: "Ready Customers + Ready Data + Ready Products",
        description:
            "Customers are already in the pipeline. Data access and partnerships are established, enabling rapid automation rollouts.",
    },
    {
        title: "Win-Win Data Loop",
        description:
            "Customers share production data → implementation improves → skills become stronger → faster deployments → long-term partnerships.",
    },
];
---

<section class="py-16">
    <div class="mx-auto max-w-6xl px-4 md:px-8">
        <!-- Heading -->
        <div class="max-w-3xl space-y-4">
            <p
                class="text-primary text-xl font-semibold uppercase tracking-tight"
            >
                Vertical Solutions
            </p>

            <h2 class="text-5xl font-bold leading-tight">
                Domain Skills Compounding Engine.
            </h2>

            <p class="text-lg leading-8 text-gray-500">
                AIOS transforms industrial automation from isolated deployments
                into a continuously improving intelligence platform.
            </p>
        </div>

        <!-- Content + Image -->
        <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
            <!-- Capability points -->
            <div>
                <ul class="space-y-8 text-lg text-gray-600">
                    {
                        capabilities.map((item) => (
                            <li class="flex items-start gap-4">
                                <div class="flex items-center shrink-0 mt-3">
                                    <div class="h-2 w-2 rounded-full bg-primary" />
                                    <div class="h-px w-16 bg-primary" />
                                </div>

                                <span class="leading-8 text-justify">
                                    {item}
                                </span>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- Lifecycle Image -->
            <div class="flex justify-center">
                <img
                    src="/images/lifecycleloop.png"
                    alt="AIOS Skill Compounding Lifecycle Loop"
                    class="w-full
                    max-w-lg
                    object-contain"
                    loading="lazy"
                />
            </div>
        </div>

        <!-- Strategic cards -->
        <div class="mt-12 grid gap-8 lg:grid-cols-2">
            {
                cards.map((card) => (
                    <div
                        class="
                    group
                    rounded-lg
                    border border-primary/10
                    bg-gradient-to-br
                    from-primary/10
                    via-white
                    to-white
                    p-8
                    transition-all
                    duration-300
                    hover:-translate-y-1
                    hover:border-primary/30
                    hover:shadow-sm
                    "
                    >
                        <h3 class="text-2xl font-bold">{card.title}</h3>

                        <p class="mt-4 leading-7 text-gray-600">
                            {card.description}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
